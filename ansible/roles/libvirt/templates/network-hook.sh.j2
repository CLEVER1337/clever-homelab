#!/bin/bash
# {{ ansible_managed }}
#
# libvirt network hook: publishes guest services on the host's LAN address.
#
# Why a hook and not a standalone nftables file: libvirt on Debian 12 drives the
# firewall through iptables, and for a NAT network it installs a REJECT in
# FORWARD for inbound-new traffic to the guests. A rule in a separate nftables
# table cannot override that — in netfilter a reject verdict in any base chain
# is terminal, so an accept elsewhere loses. The rules therefore have to go into
# the same chain, above libvirt's own. This hook is invoked by libvirt right
# after it has installed those rules, so inserting at position 1 puts us first.
#
# It also re-runs on every network start, including at boot, which is what keeps
# the rules alive across libvirt restarts that flush and rebuild everything.
#
# This script must never exit non-zero. libvirt treats a failing hook as a
# failing network: it aborts the start, and every guest attached to that network
# then fails to autostart behind it. At boot the host has no default route yet —
# enp5s0 is `allow-hotplug`, so ifupdown returns long before DHCP finishes — and
# a hook that insisted on an address there took the whole homelab down with it.
#
# Losing the port forwards costs inbound access. Losing the network costs every
# guest. So a missing address is a warning here, not an error, and the rules get
# laid down later by /etc/network/if-up.d/homelab-libvirt-forwards, which fires
# when the interface actually comes up.
#
# Invocation: $1 = network name, $2 = operation.

set -u

NETWORK="{{ libvirt_net_name }}"
HOST_IP=""

[ "${1:-}" = "$NETWORK" ] || exit 0

# Resolved at run time rather than baked in by Ansible: the host holds a DHCP
# lease, so a templated address would silently go stale after a lease change.
# Called from the branches that need it rather than at the top of the script —
# libvirt also invokes this hook for phases that touch no rules at all, and
# failing there aborted a start that had nothing to do with us.
resolve_host_ip() {
  local dev
  dev=$(ip route show default | awk '{print $5; exit}')
  [ -n "$dev" ] || return 1
  HOST_IP=$(ip -4 -o addr show dev "$dev" scope global | awk '{print $4}' | cut -d/ -f1 | head -1)
  [ -n "$HOST_IP" ] || return 1
}

# Deletes are best-effort: removing a rule that is not there is not an error
# worth aborting on.
nat_rule() { # <flag> <chain> <host_port> <dest_ip> <dest_port>
  iptables -t nat "$1" "$2" -d "$HOST_IP" -p tcp --dport "$3" \
    -j DNAT --to-destination "$4:$5" 2>/dev/null || true
}

fwd_rule() { # <flag> <dest_ip> <dest_port>
  iptables "$1" FORWARD -d "$2" -p tcp --dport "$3" \
    -m conntrack --ctstate NEW,ESTABLISHED,RELATED -j ACCEPT 2>/dev/null || true
}

# PREROUTING covers traffic arriving from the LAN; OUTPUT covers connections the
# host opens to its own address, which skip prerouting entirely.
add_all() {
{% for f in libvirt_nat_forwards %}
  # {{ f.name }}
  nat_rule -I PREROUTING {{ f.host_port }} {{ f.dest_ip }} {{ f.dest_port }}
  nat_rule -I OUTPUT {{ f.host_port }} {{ f.dest_ip }} {{ f.dest_port }}
  fwd_rule -I {{ f.dest_ip }} {{ f.dest_port }}
{% endfor %}
  :
}

del_all() {
{% for f in libvirt_nat_forwards %}
  nat_rule -D PREROUTING {{ f.host_port }} {{ f.dest_ip }} {{ f.dest_port }}
  nat_rule -D OUTPUT {{ f.host_port }} {{ f.dest_ip }} {{ f.dest_port }}
  fwd_rule -D {{ f.dest_ip }} {{ f.dest_port }}
{% endfor %}
  :
}

case "${2:-}" in
  started)
    if resolve_host_ip; then
      # Drop first, so running the hook twice cannot stack duplicate rules.
      del_all
      add_all
    else
      echo "libvirt hook: no LAN address yet, leaving the port forwards to if-up.d" >&2
    fi
    ;;
  stopped)
    # Best effort. With no address there is nothing to match on, and the rules
    # were never installed in that case anyway.
    resolve_host_ip && del_all
    ;;
esac

exit 0
