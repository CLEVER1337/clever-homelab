{{ ansible_managed | comment }}
#
# The explAIned application's credentials. Names are fixed and carry no content
# hash, because the manifests repository references them literally — see the
# note in tasks/app_secrets.yml about what that costs on a rotation.
#
# `stringData` rather than `data`: Kubernetes base64-encodes it on the way in,
# so nothing here has to be pre-encoded and a password with an awkward character
# cannot be mangled by a Jinja filter on the way through.
---
apiVersion: v1
kind: Secret
metadata:
  name: explained-postgres
  namespace: {{ k3s_app_namespace }}
  labels:
    app.kubernetes.io/part-of: explained
    app.kubernetes.io/managed-by: ansible
type: Opaque
stringData:
  # The application account on the PostgreSQL guest, which owns all four databases.
  POSTGRES_PASSWORD: {{ k3s_app_passwords.postgres | to_json }}
---
apiVersion: v1
kind: Secret
metadata:
  name: explained-clickhouse
  namespace: {{ k3s_app_namespace }}
  labels:
    app.kubernetes.io/part-of: explained
    app.kubernetes.io/managed-by: ansible
type: Opaque
stringData:
  CLICKHOUSE_PASSWORD: {{ k3s_app_passwords.clickhouse | to_json }}
---
apiVersion: v1
kind: Secret
metadata:
  name: explained-elasticsearch
  namespace: {{ k3s_app_namespace }}
  labels:
    app.kubernetes.io/part-of: explained
    app.kubernetes.io/managed-by: ansible
type: Opaque
stringData:
  # The application account on the Elasticsearch guest, not the `elastic` superuser.
  ELASTIC_PASSWORD: {{ k3s_app_passwords.elasticsearch | to_json }}
---
apiVersion: v1
kind: Secret
metadata:
  name: explained-redis
  namespace: {{ k3s_app_namespace }}
  labels:
    app.kubernetes.io/part-of: explained
    app.kubernetes.io/managed-by: ansible
type: Opaque
stringData:
  REDIS_PASSWORD: {{ k3s_app_own.redis_password | to_json }}
---
apiVersion: v1
kind: Secret
metadata:
  name: explained-jwt
  namespace: {{ k3s_app_namespace }}
  labels:
    app.kubernetes.io/part-of: explained
    app.kubernetes.io/managed-by: ansible
type: Opaque
stringData:
  # Identity signs with this; article, comment, profile and recommendation
  # validate against it. One value, five Deployments.
  JWT_KEY: {{ k3s_app_own.jwt_key | to_json }}
---
apiVersion: v1
kind: Secret
metadata:
  name: explained-grafana
  namespace: {{ k3s_app_namespace }}
  labels:
    app.kubernetes.io/part-of: explained
    app.kubernetes.io/managed-by: ansible
type: Opaque
stringData:
  # Only seeds the initial admin on an empty Grafana database. Once its PVC has
  # been written, the password lives there and changing this does nothing.
  admin-user: {{ k3s_app_grafana_user | to_json }}
  admin-password: {{ k3s_app_own.grafana_admin_password | to_json }}
