# {{ ansible_managed }}
#
# The credential CI deploys with. Paste the whole file into Forgejo as a secret
# (Settings -> Actions -> Secrets) and hand it to kubectl in the workflow.
#
# It points at the API server's address on the guest network, which the CI
# runner can reach directly and the workstation cannot — use .kubeconfig and the
# SSH tunnel for that, as the k3s play prints at the end of every run.
apiVersion: v1
kind: Config
clusters:
  - name: homelab
    cluster:
      server: https://{{ k3s_server_ip }}:{{ k3s_api_port }}
      certificate-authority-data: {{ k3s_cluster_ca }}
users:
  - name: {{ k3s_deploy_account }}
    user:
      token: {{ k3s_deploy_token }}
contexts:
  - name: {{ k3s_app_namespace }}
    context:
      cluster: homelab
      user: {{ k3s_deploy_account }}
      namespace: {{ k3s_app_namespace }}
current-context: {{ k3s_app_namespace }}
