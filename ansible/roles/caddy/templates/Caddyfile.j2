# {{ ansible_managed }}

{{ forgejo_domain }} {
{% if caddy_tls_mode == 'internal' %}
	# Caddy's own local CA. No public DNS or reachable port 80 required, which
	# is what makes this work on a LAN-only name. Clients must trust the root
	# once — see the README.
	tls internal
{% else %}
	tls {{ caddy_acme_email }}
{% endif %}

	# Git pushes and LFS objects are large; the default 10 MB cap would reject
	# anything but toy repositories.
	request_body {
		max_size 2GB
	}

	reverse_proxy 127.0.0.1:{{ forgejo_http_port }}

	encode gzip

	# Deliberately not named after the domain. `caddy validate` opens the log
	# file, and Ansible runs that as root, so a per-domain path would leave a
	# fresh root-owned file that the caddy user cannot write every time the
	# domain changes. One stable path can be pre-created with the right owner.
	log {
		output file /var/log/caddy/access.log
	}
}
{% for app in caddy_k3s_apps %}

# {{ app.domain }} -> NodePort {{ app.node_port }} on every k3s agent.
# The Service behind it lives in the application's repository, not this one.
{{ app.domain }} {
{% if caddy_tls_mode == 'internal' %}
	tls internal
{% else %}
	tls {{ caddy_acme_email }}
{% endif %}

	reverse_proxy {% for node in groups['k3s_agents'] %}{{ hostvars[node].ansible_host }}:{{ app.node_port }} {% endfor %}{
		lb_policy round_robin
{% if app.health_uri is defined %}
		# Without this a node whose pods have been rescheduled elsewhere keeps
		# taking its share of the requests and answering 502 to each one.
		health_uri {{ app.health_uri }}
		health_interval 10s
{% endif %}
	}

	encode gzip

	log {
		output file /var/log/caddy/access.log
	}
}
{% endfor %}
