# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

hypervisor_host = "192.168.0.19" # <-- your Debian box
hypervisor_user = "supervisor"   # <-- bootstrap.yml puts this user in the `libvirt` group

ssh_private_key_path = "~/.ssh/id_ed25519"
ssh_public_key       = "ssh-ed25519 AAAA... you@laptop" # contents of ~/.ssh/id_ed25519.pub

# Must match `ansible_user` in ansible/inventory/hosts.yml.
admin_user = "supervisor"

# Defaults below are fine to leave alone. Uncomment to resize a machine or to
# add another. Every entry also needs an address in ansible/inventory/hosts.yml.
#
# `pool` is optional and defaults to `homelab`, on the host's root filesystem;
# name `homelab-db` to put a disk on the dedicated partition instead. Both it
# and `disk_gb` recreate the disk empty when changed — see variables.tf.
#
# vms = {
#   forgejo = {
#     ip        = "10.42.0.10"
#     vcpu      = 2
#     memory_mb = 4096
#     disk_gb   = 25
#   }
#   runner = {
#     ip        = "10.42.0.11"
#     vcpu      = 4
#     memory_mb = 4096
#     disk_gb   = 20
#   }
# }
