# Terraform
.terraform/
# .terraform.lock.hcl is deliberately NOT ignored — commit it so provider
# versions are reproducible.
*.tfstate
*.tfstate.*
*.tfplan
terraform.tfvars
crash.log

# Ansible
*.retry
ansible/collections/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# Guest host keys, trusted on first use and reset on rebuild
ansible/inventory/.known_hosts_guests

# Fetched from the k3s server on every run. Cluster-admin credentials.
ansible/inventory/.kubeconfig
# Built on every run for CI to deploy with. Narrower than the one above — one
# namespace, no cluster-wide rights — but still a live token.
ansible/inventory/.kubeconfig-deploy
